# Every variable the code reads, with a comment on where the value comes from.
# Copy to .env.local and fill in. Server-only keys have no NEXT_PUBLIC_ prefix.

# Supabase → Settings → API. Use the secret (service_role) key on the server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment; used for Origin checks and links in email.
PUBLIC_BASE_URL=

# Error tracking (optional until you add a tracker).
SENTRY_DSN=
